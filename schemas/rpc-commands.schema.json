{
  "$defs": {
    "PermissionDecision": {
      "description": "A client answer to a [`RpcPermissionRequest`].",
      "oneOf": [
        {
          "const": "allow_once",
          "description": "Allow this call only.",
          "type": "string"
        },
        {
          "const": "allow_always",
          "description": "Allow this tool for the rest of the session.",
          "type": "string"
        },
        {
          "const": "deny",
          "description": "Deny the call.",
          "type": "string"
        }
      ]
    },
    "PermissionMode": {
      "description": "How the server treats mutating tool calls.",
      "oneOf": [
        {
          "const": "headless",
          "description": "Version 1 behavior: mutating tools are denied unless listed in `--allow`.",
          "type": "string"
        },
        {
          "const": "ask",
          "description": "Ask the client before each mutating call that is not pre-approved.",
          "type": "string"
        },
        {
          "const": "allow",
          "description": "Allow every mutating call without asking.",
          "type": "string"
        }
      ]
    },
    "RpcAttachment": {
      "description": "One explicit attachment in a `prompt` command.",
      "oneOf": [
        {
          "description": "A path relative to the session working directory.",
          "properties": {
            "path": {
              "description": "File path to read and attach.",
              "type": "string"
            },
            "type": {
              "const": "path",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "A base64-encoded image supplied by the client.",
          "properties": {
            "data": {
              "description": "Base64-encoded image bytes.",
              "type": "string"
            },
            "mime_type": {
              "description": "MIME type such as `image/png`.",
              "type": "string"
            },
            "name": {
              "description": "Optional display name for prompts and logs.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data",
            "mime_type"
          ],
          "type": "object"
        }
      ]
    },
    "RpcSubagentMode": {
      "description": "A subagent delegation mode accepted by [`RpcCommand::SetSubagents`].",
      "oneOf": [
        {
          "const": "off",
          "description": "Delegation is refused for the session.",
          "type": "string"
        },
        {
          "const": "auto",
          "description": "The model decides whether to delegate.",
          "type": "string"
        },
        {
          "const": "force",
          "description": "The model is told to delegate.",
          "type": "string"
        },
        {
          "const": "once",
          "description": "Force delegation for the next prompt only.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One command read from stdin.",
  "oneOf": [
    {
      "description": "Start a run with a user message.",
      "properties": {
        "attachments": {
          "description": "Explicit attachments appended to the message.",
          "items": {
            "$ref": "#/$defs/RpcAttachment"
          },
          "type": "array"
        },
        "command": {
          "const": "prompt",
          "type": "string"
        },
        "message": {
          "description": "Prompt text. `@path` attachments are expanded.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "Steer the active run with an extra message.",
      "properties": {
        "command": {
          "const": "steer",
          "type": "string"
        },
        "message": {
          "description": "Steering text.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "Queue a message for after the active run settles.",
      "properties": {
        "command": {
          "const": "follow_up",
          "type": "string"
        },
        "message": {
          "description": "Follow-up text.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "Cancel the active run.",
      "properties": {
        "command": {
          "const": "abort",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Change how mutating tools are authorized.",
      "properties": {
        "command": {
          "const": "set_permission_mode",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/PermissionMode",
          "description": "One of `headless`, `ask`, or `allow`."
        }
      },
      "required": [
        "command",
        "mode"
      ],
      "type": "object"
    },
    {
      "description": "Answer a pending `permission_request`.",
      "properties": {
        "command": {
          "const": "permission_response",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/PermissionDecision",
          "description": "Client decision."
        },
        "request_id": {
          "description": "Identifier from the `permission_request` record.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    {
      "description": "Report the current model, thinking level, and session state.",
      "properties": {
        "command": {
          "const": "get_state",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "List selectable models and provider details.",
      "properties": {
        "command": {
          "const": "get_catalog",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "List the built-in theme palettes as semantic hex colors.",
      "properties": {
        "command": {
          "const": "get_themes",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Report effective configuration without secrets.",
      "properties": {
        "command": {
          "const": "get_config",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Write one value to `config.toml`.",
      "properties": {
        "command": {
          "const": "set_config",
          "type": "string"
        },
        "key": {
          "description": "Key such as `provider`, `model`, `thinking`, `max-turns`, `allow`,\nor `base-url`.",
          "type": "string"
        },
        "value": {
          "description": "New value; `allow` accepts a comma-separated list.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "key",
        "value"
      ],
      "type": "object"
    },
    {
      "description": "Report credential state for every provider.",
      "properties": {
        "command": {
          "const": "auth_status",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Store an API key for one provider.",
      "properties": {
        "command": {
          "const": "auth_set_key",
          "type": "string"
        },
        "key": {
          "description": "API key. Never echoed in responses or logs.",
          "type": "string"
        },
        "provider": {
          "description": "Provider identifier such as `deepseek`, `openrouter`, or `gemini`.",
          "type": "string"
        },
        "verify": {
          "description": "Contact the provider to verify the key before storing it.",
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "provider",
        "key"
      ],
      "type": "object"
    },
    {
      "description": "Remove a stored API key.",
      "properties": {
        "command": {
          "const": "auth_logout",
          "type": "string"
        },
        "provider": {
          "description": "Provider identifier.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "provider"
      ],
      "type": "object"
    },
    {
      "description": "Report subagent configuration, live runs, and the session mode.",
      "properties": {
        "command": {
          "const": "get_subagents",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Change the session delegation mode or parallelism.",
      "properties": {
        "command": {
          "const": "set_subagents",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/RpcSubagentMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "New mode; omit to keep the current mode."
        },
        "parallel": {
          "description": "New concurrency limit; omit to keep the current limit.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Cancel one running child by its parent `task` call id.",
      "properties": {
        "call_id": {
          "description": "Tool call id of the parent `task` call.",
          "type": "string"
        },
        "command": {
          "const": "cancel_subagent",
          "type": "string"
        }
      },
      "required": [
        "command",
        "call_id"
      ],
      "type": "object"
    },
    {
      "description": "Return the projected transcript messages.",
      "properties": {
        "command": {
          "const": "get_messages",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Return the session entry tree.",
      "properties": {
        "command": {
          "const": "get_entries",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Return token, cost, and context statistics.",
      "properties": {
        "command": {
          "const": "get_session_stats",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Start a new session for the current directory.",
      "properties": {
        "command": {
          "const": "new_session",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Change the model for subsequent runs.",
      "properties": {
        "command": {
          "const": "set_model",
          "type": "string"
        },
        "model": {
          "description": "Model identifier, used verbatim.",
          "type": "string"
        },
        "provider": {
          "description": "Optional provider override; defaults to the current provider.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "model"
      ],
      "type": "object"
    },
    {
      "description": "Change the reasoning effort for subsequent runs.",
      "properties": {
        "command": {
          "const": "set_thinking",
          "type": "string"
        },
        "level": {
          "description": "Thinking level: off, minimal, low, medium, high, xhigh, or max.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "level"
      ],
      "type": "object"
    },
    {
      "description": "Compact the context once.",
      "properties": {
        "command": {
          "const": "compact",
          "type": "string"
        },
        "instructions": {
          "description": "Optional custom summarization instructions.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Export the current session as a self-contained HTML file.",
      "properties": {
        "command": {
          "const": "export_html",
          "type": "string"
        },
        "path": {
          "description": "Destination path. Defaults to `codie-session-<id>.html` in the cwd.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Respond, then stop reading commands.",
      "properties": {
        "command": {
          "const": "shutdown",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "id": {
      "description": "Optional client identifier echoed in the response.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "RpcRequest",
  "type": "object"
}
