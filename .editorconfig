# Editor defaults for the codie repository.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust, TOML, and shell sources follow rustfmt and cargo conventions.
[*.{rs,toml,sh}]
indent_size = 4
max_line_length = 100

# YAML, Markdown, and JSON keep the 2-space style used by GitHub tooling.
[*.{yml,yaml}]
indent_size = 2

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false

[*.json]
indent_size = 2

# Generated and vendored content is left untouched.
[target/**]
ignore = true

[*.snap]
insert_final_newline = false
