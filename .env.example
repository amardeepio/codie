# codie local environment
#
# Copy this file to `.env` for local development. `.env` is gitignored.
# Existing process environment variables always win over values in this file.
#
# codie loads `./.env` automatically, or an explicit file via
# `codie --env-file path/to/file ...` or CODIE_ENV_FILE.

# Provider credentials
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Defaults (CLI flags override these)
# CODIE_PROVIDER=deepseek
# CODIE_MODEL=deepseek-flash
# CODIE_THINKING=medium
# CODIE_MAX_TURNS=200
# CODIE_ALLOW=edit,bash

# Storage locations
# CODIE_CONFIG_DIR=~/.config/codie
# CODIE_DATA_DIR=~/.local/share/codie
# CODIE_SESSION_DIR=~/.local/share/codie/sessions
